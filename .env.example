# Select database backend: sqlite (default) or mssql
DB_CLIENT=mssql
PORT=5000
HOST=0.0.0.0

# Local Windows run: Windows Authentication
MSSQL_AUTH=windows
MSSQL_SERVER=localhost
# Set MSSQL_INSTANCE=SQLEXPRESS if SQL Server is a named instance.
MSSQL_INSTANCE=SQLEXPRESS
# For a default SQL Server instance with TCP port 1433, leave MSSQL_INSTANCE blank and set MSSQL_PORT=1433.
MSSQL_PORT=
MSSQL_DATABASE=AutoSalonDB
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECTION_TIMEOUT=15000
MSSQL_REQUEST_TIMEOUT=15000

# Docker/Linux run: Compose overrides MSSQL_AUTH=sql and MSSQL_SERVER=host.docker.internal.
# Create a SQL Server login with access to AutoSalonDB, then put its credentials here in your local .env.
MSSQL_USER=
MSSQL_PASSWORD=
